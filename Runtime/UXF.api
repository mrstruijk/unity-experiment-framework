namespace BasteRainGames
{
    public enum HideIf
    {
        Equal = 0,
        NotEqual = 1,
    }

    [System.AttributeUsage(System.AttributeTargets.Field, AllowMultiple = true, Inherited = true)] public class HideIfAttribute : HidingAttribute
    {
        public readonly bool state;
        public readonly string variable;
        public HideIfAttribute(string variable, bool state, int order = 0) {}
    }

    [System.AttributeUsage(System.AttributeTargets.Field, AllowMultiple = true, Inherited = true)] public class HideIfEnumValueAttribute : HidingAttribute
    {
        public readonly bool hideIfEqual;
        public readonly int[] states;
        public readonly string variable;
        public HideIfEnumValueAttribute(string variable, HideIf hideIf, params int[] states) {}
    }

    public class HideIfExampleScript : UnityEngine.MonoBehaviour
    {
        public TestData a;
        [HideIf(@"hide", true, 0)] public TestData b;
        [HideIf(@"hide", true, 0)] public TestDataParent c;
        public TestDataParent d;
        public bool hide;
        [HideIfEnumValue(@"testEnum", HideIf.Equal, new[] {0})] public string isNotVal1 = @"Val 1 not selected";
        [HideIfEnumValue(@"testEnum", HideIf.Equal, new[] {1, 2})] public string isNotVal2Or3 = @"Neither Val 2 nor 3 are selected";
        [HideIfEnumValue(@"testEnum", HideIf.NotEqual, new[] {0})] public string isVal1 = @"Val 1 selected";
        [HideIfEnumValue(@"testEnum", HideIf.NotEqual, new[] {1, 2})] public string isVal2Or3 = @"Val 2 or 3 are selected";
        [UnityEngine.Space(10f)] public UnityEngine.Object obj;
        [HideIfNull(@"obj", 0)] public string objIsNotNull = @"Shown as obj is not null!";
        [HideIfNotNull(@"obj", 0)] public string objIsNull = @"Shown as obj is null!";
        [HideIf(@"showS1", false, 0)] public string s1 = @"S1";
        [HideIf(@"showS1", true, 0)] public string s2 = @"S2 instead";
        public bool showS1;
        [UnityEngine.Space(10f)] public HideIfExampleScript.TestEnum testEnum;
        public HideIfExampleScript() {}
        public enum TestEnum
        {
            Val1 = 0,
            Val2 = 1,
            Val3 = 2,
        }
    }

    [System.AttributeUsage(System.AttributeTargets.Field, AllowMultiple = true, Inherited = true)] public class HideIfNotNullAttribute : HidingAttribute
    {
        public readonly string variable;
        public HideIfNotNullAttribute(string variable, int order = 0) {}
    }

    [System.AttributeUsage(System.AttributeTargets.Field, AllowMultiple = true, Inherited = true)] public class HideIfNullAttribute : HidingAttribute
    {
        public readonly string variable;
        public HideIfNullAttribute(string variable, int order = 0) {}
    }

    public class HidingAttribute : UnityEngine.PropertyAttribute
    {
        public HidingAttribute() {}
    }

    public class TestData : TestDataParent
    {
        public TestData() {}
    }

